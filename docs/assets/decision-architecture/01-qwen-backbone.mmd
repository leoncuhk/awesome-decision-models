flowchart LR
  T["文本 token"] --> E["词嵌入<br/>Embedding"]
  I["图像／视频<br/>可选"] --> V["视觉编码器<br/>Vision encoder"] --> M["视觉 merger<br/>对齐语言维度"]
  E --> F["按位置融合<br/>文本与视觉表示"]
  M --> F
  F --> B["混合语言骨干<br/>3层 DeltaNet + 1层全注意力<br/>4B重复8组；27B重复16组"]
  B --> N["最终 RMSNorm<br/>各位置 hidden states H"]
  N --> L["原词表头 lm_head<br/>hidden → 词表 logits"]
  L --> O["词表 softmax／采样<br/>下一个 token<br/>普通生成式部署"]
  classDef focal fill:#fff2dc,stroke:#996500,stroke-width:2px,color:#222;
  class B,L focal;
