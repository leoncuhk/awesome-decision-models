flowchart LR
  X["题目＋候选 x"] --> S["当前因果LM θ 采样推理<br/>no_grad"]
  S --> R["固定推理token r_i<br/>离散选择不反传"]
  X --> F["可训练LM θ 重新前向<br/>题目＋r_i＋Answer:<br/>共享主干＋原词表头"]
  R --> F
  F --> U["Answer位置<br/>取K个标签token logits<br/>候选内 softmax"]
  U --> L["每条推理各自 proper loss<br/>Brier 或负对数分数"]
  Y["正确标签 y<br/>仅用于loss"] --> L
  R --> REF["冻结初始 reference θ0<br/>读相同题目与推理历史"]
  X --> REF
  F --> KL["推理历史上的<br/>全词表 token KL"]
  REF --> KL
  L --> SUM["平均 proper loss ＋ λ token KL"]
  KL --> SUM
  SUM -. "梯度更新共享 θ" .-> F
  classDef train fill:#fff2dc,stroke:#996500,stroke-width:2px,color:#222;
  classDef frozen fill:#edf1f5,stroke:#586579,color:#222;
  class F,U,L,SUM train;
  class S,R,REF frozen;
